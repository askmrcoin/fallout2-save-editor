{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Fallout 2 save game editor",
  "type": "module",
  "scripts": {
    "analyze": "vite analyze",
    "build": "bun run build:clean && bun run bamboogen:prod && vite build --outDir dist",
    "build:clean": "rm -rf dist/*",
    "build:dev": "bun run bamboogen && vite dev",
    "compress": "find dist -type f -exec brotli -jf {} \\;",
    "deploy:prod": "git hook run pre-commit && bunx netlify-cli deploy --prod",
    "deploy": "bunx netlify-cli deploy",
    "dev": "bun run bamboogen && vite dev --force",
    "devtools": "vite build",
    "doctor": "react-doctor --no-lint",
    "fmt:check": "oxfmt --check",
    "fmt": "oxfmt",
    "lint:watch": "watchexec -w src -c -- bun run lint",
    "lint": "bun run bamboogen && oxlint -c oxlint.config.ts -f stylish",
    "mkcert": "mkcert icert.org -install",
    "bamboogen:prod": "NODE_ENV=production bamboo codegen --clean",
    "bamboogen": "bamboo codegen --clean --silent",
    "preview": "vite preview",
    "serve": "http-server dist -bS -C cert/icert.org+1.pem -K cert/icert.org+1-key.pem",
    "test": "bun test",
    "test:ct": "cypress open --component --browser chrome",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@wailsio/runtime": "^3.1.0",
    "preact": "11.2.0",
    "preact-iso": "^2.12.2",
    "preact-zustand": "^1.0.5",
    "reselect": "^5.3.0"
  },
  "devDependencies": {
    "@bamboocss/dev": "1.64.1",
    "@bamboocss/preset-base": "1.64.1",
    "@bamboocss/types": "1.64.1",
    "@bamboocss/vite": "1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/bun": "1.4.4",
    "cypress": "^16.2.1",
    "cypress-ct-preact": "1.0.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.2.0",
    "netlify-cli": "^27.16.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-html-minifier": "^1.0.5",
    "watch-exec": "^1.2.2"
  }
}
